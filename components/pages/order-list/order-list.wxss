/* pages/order-list/order-list.wxss */
.container {
  min-height: 100vh;
  background: #f0f0f0;
}
.tabs {
  display: flex;
  background: #fff;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab.active {
  color: #1677FF;
  font-weight: 600;
}
.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #1677FF;
  border-radius: 2rpx;
}
.order-list {
  padding: 20rpx 30rpx;
}
.order-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.order-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.order-status.success {
  background: #e8f5e9;
  color: #2e7d32;
}
.order-status.pending {
  background: #fff3e0;
  color: #ef6c00;
}
.order-status.failed {
  background: #ffebee;
  color: #c62828;
}
.order-body {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}
.order-info { flex: 1; }
.order-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
}
.order-label {
  font-size: 24rpx;
  color: #999;
}
.order-value {
  font-size: 24rpx;
  color: #666;
}
.order-amount {
  text-align: right;
}
.amount-symbol {
  font-size: 24rpx;
  color: #ff4d4f;
}
.amount-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff4d4f;
}
.empty-state {
  text-align: center;
  padding: 150rpx 30rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}
