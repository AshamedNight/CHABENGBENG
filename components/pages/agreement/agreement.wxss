/* pages/agreement/agreement.wxss */
.agreement-page {
  padding: 32rpx;
  background: #F5F7FA;
  min-height: 100vh;
  box-sizing: border-box;
}

.agreement-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 8rpx;
}

.agreement-update {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 40rpx;
}

.section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-h {
  font-size: 30rpx;
  font-weight: 600;
  color: #1677FF;
  margin-bottom: 16rpx;
}

.section-p {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  white-space: pre-wrap;
}

.agreement-end {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  padding: 32rpx 0 64rpx;
}
