/* pages/result/result.wxss */
.container {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 60rpx;
}

/* 未收录 */
.not-found-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.not-found-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.not-found-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 12rpx;
}
.not-found-desc {
  font-size: 26rpx;
  color: #86909C;
  margin-bottom: 40rpx;
  line-height: 1.5;
}
.not-found-btn {
  width: 60%;
  margin: 0 auto;
}

/* 目标信息卡 */
.target-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.target-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.target-avatar {
  width: 100rpx;
  height: 100rpx;
  background: #F2F3F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}
.target-info { flex: 1; }
.target-uid {
  font-size: 34rpx;
  font-weight: bold;
  color: #1D2129;
  margin-bottom: 8rpx;
}
.target-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.platform-tag {
  background: #F2F3F5;
  color: #4E5969;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.risk-tag {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.risk-high { background: #ffebee; color: #c62828; }
.risk-medium { background: #fff3e0; color: #ef6c00; }
.risk-low { background: #e8f5e9; color: #2e7d32; }
.risk-none { background: #f5f5f5; color: #86909C; }

/* 累计投诉 - 蓝色背景 */
.complaint-count {
  background: linear-gradient(135deg, #e6f4ff 0%, #bae0ff 100%);
  padding: 24rpx;
  border-radius: 16rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.count-label {
  font-size: 26rpx;
  color: #0052D9;
  font-weight: 500;
}
.count-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #1677FF;
}
.count-unit {
  font-size: 26rpx;
  color: #0052D9;
}

/* 历史记录 */
.records-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.records-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.records-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}
.records-count {
  font-size: 24rpx;
  color: #86909C;
}
.records-list {
  max-height: none;
}
.record-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
  position: relative;
}
.record-item:last-child { border-bottom: none; }
.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.record-user {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.user-avatar {
  font-size: 28rpx;
}
.user-nickname {
  font-size: 28rpx;
  color: #1D2129;
  font-weight: 500;
}
.record-status {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.status-done {
  background: #e8f5e9;
  color: #2e7d32;
}
.status-pending {
  background: #ffebee;
  color: #c62828;
}
.record-no {
  font-size: 24rpx;
  color: #86909C;
  margin-bottom: 4rpx;
}
.record-time {
  font-size: 22rpx;
  color: #C9CDD4;
  margin-bottom: 12rpx;
}
.record-evidence {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.evidence-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #F2F3F5;
}
.evidence-more {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #F2F3F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #86909C;
}
.record-arrow {
  font-size: 24rpx;
  color: #1677FF;
  text-align: right;
}

/* 模糊锁定区域 */
.records-locked {
  position: relative;
  overflow: hidden;
  padding: 20rpx 0;
}
.locked-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #fff7e6;
  border-radius: 12rpx;
}
.lock-icon {
  font-size: 28rpx;
}
.lock-text {
  font-size: 24rpx;
  color: #ef6c00;
  flex: 1;
}
.locked-records {
  filter: blur(3px);
  user-select: none;
  pointer-events: none;
}
.unlock-btn {
  margin-top: 24rpx;
}

/* 维权服务说明 */
.service-tip {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f0f7ff;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}
.service-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}
.service-text {
  font-size: 24rpx;
  color: #4E5969;
  line-height: 1.5;
  flex: 1;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
  font-size: 24rpx;
  color: #86909C;
  margin-top: 40rpx;
  padding: 0 30rpx;
}

/* 付费弹窗 */
.pay-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.pay-modal {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx 30rpx;
  width: 100%;
  position: relative;
}
.pay-close {
  position: absolute;
  top: 20rpx;
  right: 30rpx;
  font-size: 40rpx;
  color: #C9CDD4;
  line-height: 1;
}
.pay-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 24rpx;
  color: #1D2129;
}
.pay-benefits {
  margin-bottom: 24rpx;
}
.benefit-item {
  font-size: 26rpx;
  color: #4E5969;
  padding: 6rpx 0;
}
.pay-option {
  border: 2rpx solid #E5E6EB;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
}
.pay-option.selected {
  border-color: #1677FF;
  background: #f0f7ff;
}
.pay-option-vip.selected {
  border-color: #FFD700;
  background: #fffbe6;
}
.option-badge {
  position: absolute;
  top: 0;
  right: 20rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 0 0 12rpx 12rpx;
}
.option-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 4rpx;
}
.option-desc {
  font-size: 24rpx;
  color: #86909C;
}
.pay-confirm {
  margin-top: 10rpx;
}
.pay-agreement {
  font-size: 22rpx;
  color: #86909C;
  text-align: center;
  margin-top: 16rpx;
}

/* 维权服务操作菜单 */
.action-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 998;
  display: flex;
  align-items: flex-end;
}
.action-panel {
  background: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}
.action-header {
  text-align: center;
  margin-bottom: 24rpx;
}
.action-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  display: block;
}
.action-subtitle {
  font-size: 24rpx;
  color: #86909C;
  margin-top: 6rpx;
  display: block;
}
.action-list {
  margin-bottom: 20rpx;
}
.action-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}
.action-item:last-child { margin-bottom: 0; }
.action-icon {
  width: 72rpx;
  height: 72rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.action-info {
  flex: 1;
}
.action-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 4rpx;
}
.action-desc {
  font-size: 22rpx;
  color: #86909C;
  line-height: 1.4;
}
.action-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #c62828;
  margin-left: 16rpx;
}
.action-cancel {
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  color: #86909C;
  border-top: 1rpx solid #F2F3F5;
  margin: 0 -30rpx -30rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
