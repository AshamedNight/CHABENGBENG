<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 用户信息区 -->
  <view class="user-header">
    <view class="user-bg"></view>
    <view class="user-content">
      <view class="user-avatar-wrap" bindtap="onAvatarTap">
        <image wx:if="{{avatar}}" class="user-avatar" src="{{avatar}}" mode="aspectFill"></image>
        <view wx:else class="user-avatar default-avatar">👤</view>
        <view class="vip-crown" wx:if="{{isVip}}">👑</view>
        <view class="avatar-edit">✏️</view>
      </view>
      <view class="user-info">
        <view class="user-nickname" bindtap="onNicknameTap">
          {{nickname}}
          <text class="nickname-edit">✏️</text>
        </view>
        <view class="user-uid" bindtap="copyUid">
          <text class="uid-label">UID：</text>
          <text class="uid-value">{{uid}}</text>
          <text class="uid-copy">复制</text>
        </view>
        <view class="user-vip">
          <block wx:if="{{isVip}}">
            <text class="vip-tag">👑 VIP会员</text>
            <text class="vip-expire">{{vipExpireText}}到期</text>
          </block>
          <block wx:else>
            <text class="normal-tag">普通用户</text>
            <text class="open-vip-btn" bindtap="goVip">开通VIP ›</text>
          </block>
        </view>
      </view>
    </view>
  </view>

  <!-- 查询次数卡片 -->
  <view class="quota-card">
    <block wx:if="{{isVip}}">
      <view class="quota-header">
        <text class="quota-title">VIP查询次数</text>
        <text class="quota-num">{{usedCount}}/80次</text>
      </view>
      <view class="quota-progress">
        <view class="progress-bar" style="width: {{progressPercent}}%"></view>
      </view>
      <view class="quota-footer">
        <text class="quota-remain">剩余 {{vipCount}} 次</text>
        <view class="quota-action" wx:if="{{vipCount === 0}}" bindtap="buySingle">
          <text>购买单次 ¥9.9</text>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="quota-free">
        <view class="quota-free-left">
          <text class="quota-free-title">您尚未开通查询功能</text>
          <text class="quota-free-desc">开通VIP年卡，80次查询（50次+赠30次）</text>
        </view>
        <view class="quota-free-btn quota-free-btn-gold" bindtap="goVip">开通VIP</view>
      </view>
    </block>
  </view>

  <!-- 我的材料单 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">📋 我的提交</text>
      <text class="section-more" bindtap="goComplaintList">全部 ›</text>
    </view>
    <view class="complaint-list" wx:if="{{complaints.length > 0}}">
      <view class="complaint-item" wx:for="{{complaints}}" wx:key="id" bindtap="goComplaintDetail" data-id="{{item.id}}">
        <view class="complaint-row">
          <text class="complaint-no">{{item.orderNo}}</text>
          <text class="status-tag status-{{item.statusClass}}">{{item.status}}</text>
        </view>
        <view class="complaint-desc">相关对象：{{item.targetUid}} · {{item.platform}}</view>
        <view class="complaint-time">{{item.timeText}}</view>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无材料单</text>
      <button class="empty-btn" bindtap="goComplaint">去提交</button>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goQueryHistory">
      <text class="menu-icon">🔍</text>
      <text class="menu-name">查询历史</text>
      <text class="menu-lock" wx:if="{{!isVip}}">VIP</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goOrderList">
      <text class="menu-icon">📦</text>
      <text class="menu-name">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goVip">
      <text class="menu-icon">👑</text>
      <text class="menu-name">会员专区</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="showHelp">
      <text class="menu-icon">❓</text>
      <text class="menu-name">帮助与反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="showAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-name">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAgreement" data-type="user">
      <text class="menu-icon">📄</text>
      <text class="menu-name">用户协议</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAgreement" data-type="privacy">
      <text class="menu-icon">🛡️</text>
      <text class="menu-name">隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="contactService">
      <text class="menu-icon">💬</text>
      <text class="menu-name">联系客服</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="version-text">v1.5.0</view>
</view>
