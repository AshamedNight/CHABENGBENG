/* pages/profile-edit/profile-edit.wxss */
.container {
  min-height: 100vh;
  padding: 30rpx;
}

.edit-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 30rpx;
  text-align: center;
}

/* 头像 */
.avatar-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  margin: 0 auto 24rpx;
  position: relative;
  overflow: hidden;
  background: #F2F3F5;
}
.avatar-image {
  width: 100%;
  height: 100%;
}
.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.placeholder-icon {
  font-size: 60rpx;
  margin-bottom: 8rpx;
}
.placeholder-text {
  font-size: 22rpx;
  color: #86909C;
}
.avatar-edit-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  background: #1677FF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border: 3rpx solid #fff;
}
.avatar-tip {
  font-size: 24rpx;
  color: #86909C;
  text-align: center;
  line-height: 1.5;
}

/* 昵称 */
.input-wrapper {
  position: relative;
  margin-bottom: 24rpx;
}
.nickname-input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1D2129;
  background: #fff;
}
.input-placeholder {
  color: #C9CDD4;
}
.char-count {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #86909C;
}
.nickname-rules {
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx;
}
.rule-item {
  font-size: 24rpx;
  color: #86909C;
  line-height: 1.8;
}

/* 保存按钮 */
.save-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.save-btn {
  margin: 0;
}
