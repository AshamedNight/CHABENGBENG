/* pages/photo-match/photo-match.wxss */
.container {
  min-height: 100vh;
  padding: 30rpx;
}

/* 上传区域 */
.upload-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  margin-bottom: 24rpx;
}
.upload-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  text-align: center;
  margin-bottom: 8rpx;
}
.upload-desc {
  font-size: 24rpx;
  color: #86909C;
  text-align: center;
  margin-bottom: 30rpx;
}
.upload-area {
  width: 100%;
  height: 360rpx;
  background: #F7F8FA;
  border: 2rpx dashed #C9CDD4;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.upload-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
.upload-text {
  font-size: 28rpx;
  color: #1677FF;
  font-weight: 500;
  margin-bottom: 8rpx;
}
.upload-tip {
  font-size: 22rpx;
  color: #86909C;
}
.preview-area {
  width: 100%;
}
.preview-image {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
}
.preview-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.rechoose {
  background: #F2F3F5;
  color: #4E5969;
}
.match-btn {
  background: linear-gradient(135deg, #1677FF 0%, #0052D9 100%);
  color: #fff;
}

/* 加载中 */
.loading-section {
  text-align: center;
  padding: 60rpx 0;
}
.loading-icon {
  font-size: 60rpx;
  animation: rotate 1s linear infinite;
  display: inline-block;
}
@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: #86909C;
  margin-top: 16rpx;
}

/* 结果区域 */
.result-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.result-header {
  margin-bottom: 20rpx;
}
.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}
.match-list {
  margin-bottom: 20rpx;
}
.match-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
  position: relative;
}
.match-item:last-child { border-bottom: none; }
.match-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F2F3F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.match-avatar image {
  width: 100%;
  height: 100%;
}
.match-info {
  flex: 1;
}
.match-uid {
  font-size: 28rpx;
  color: #1D2129;
  font-weight: 500;
  margin-bottom: 6rpx;
}
.match-meta {
  display: flex;
  gap: 16rpx;
  font-size: 22rpx;
  color: #86909C;
}
.match-platform {
  background: #F2F3F5;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.match-rate {
  text-align: center;
  margin-right: 16rpx;
}
.rate-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #1677FF;
  display: block;
}
.rate-label {
  font-size: 20rpx;
  color: #86909C;
}
.match-arrow {
  color: #C9CDD4;
  font-size: 32rpx;
}

/* 无匹配 */
.no-match {
  text-align: center;
  padding: 40rpx 0;
}
.no-match-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}
.no-match-title {
  font-size: 30rpx;
  color: #1D2129;
  font-weight: 500;
  margin-bottom: 8rpx;
}
.no-match-desc {
  font-size: 24rpx;
  color: #86909C;
  margin-bottom: 24rpx;
}
.no-match-btn {
  width: 60%;
  margin: 0 auto;
}

.result-tip {
  font-size: 22rpx;
  color: #86909C;
  background: #F7F8FA;
  padding: 16rpx;
  border-radius: 12rpx;
  line-height: 1.5;
}
