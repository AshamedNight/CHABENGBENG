/* pages/service-contact/service-contact.wxss */
.container {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 200rpx;
}

/* 信息卡片 */
.info-card {
  background: linear-gradient(135deg, #1677FF 0%, #0052D9 100%);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  color: #fff;
  margin-bottom: 24rpx;
  text-align: center;
}
.info-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}
.info-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.info-desc {
  font-size: 24rpx;
  line-height: 1.6;
  opacity: 0.9;
  margin-bottom: 16rpx;
}
.info-complaint {
  font-size: 22rpx;
  background: rgba(255,255,255,0.15);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  display: inline-block;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  margin-bottom: 24rpx;
}
.form-textarea {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #E5E6EB;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: #fff;
  color: #1D2129;
  height: 200rpx;
}
.form-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #E5E6EB;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: #fff;
  color: #1D2129;
}
.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #86909C;
  margin-top: 8rpx;
}
.required {
  color: #c62828;
  margin-left: 4rpx;
}

/* 服务保障 */
.guarantee-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.guarantee-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 16rpx;
}
.guarantee-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.guarantee-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.guarantee-text {
  font-size: 26rpx;
  color: #4E5969;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.submit-btn {
  margin: 0;
}
.submit-tip {
  text-align: center;
  font-size: 22rpx;
  color: #86909C;
  margin-top: 12rpx;
}
