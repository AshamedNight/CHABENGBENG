/* pages/complaint-detail/complaint-detail.wxss */
.container {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 180rpx;
}

/* 状态卡片 - 企查查蓝 */
.status-card {
  background: linear-gradient(135deg, #1677FF 0%, #0052D9 100%);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 24rpx;
}
.status-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}
.status-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.status-no {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 时间线 */
.timeline-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.timeline-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 24rpx;
}
.timeline-list {
  padding-left: 20rpx;
}
.timeline-item {
  display: flex;
  padding-bottom: 30rpx;
  position: relative;
}
.timeline-item:last-child { padding-bottom: 0; }
.timeline-item::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: #E5E6EB;
}
.timeline-item:last-child::before { display: none; }
.timeline-item.done::before { background: #1677FF; }
.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #E5E6EB;
  margin-right: 20rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.timeline-item.done .timeline-dot { background: #1677FF; }
.timeline-item.active .timeline-dot {
  background: #1677FF;
  box-shadow: 0 0 0 6rpx rgba(22,119,255,0.2);
}
.timeline-content { flex: 1; }
.timeline-label {
  font-size: 28rpx;
  color: #1D2129;
  font-weight: 500;
  margin-bottom: 4rpx;
}
.timeline-item:not(.done):not(.active) .timeline-label { color: #86909C; }
.timeline-time {
  font-size: 24rpx;
  color: #86909C;
}

/* 详情卡片 */
.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 20rpx;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}
.detail-row:last-child { border-bottom: none; }
.detail-row-column {
  flex-direction: column;
  align-items: flex-start;
}
.detail-label {
  font-size: 28rpx;
  color: #86909C;
  flex-shrink: 0;
}
.detail-value {
  font-size: 28rpx;
  color: #1D2129;
  text-align: right;
}
.detail-row-column .detail-value {
  text-align: left;
  margin-top: 8rpx;
  line-height: 1.6;
}
.detail-desc {
  color: #4E5969;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}
.detail-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #F2F3F5;
}
.detail-image.large {
  width: 200rpx;
  height: 200rpx;
}

/* 操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.action-bar .btn-outline,
.action-bar .btn-primary {
  flex: 1;
  margin: 0;
  padding: 20rpx;
  font-size: 28rpx;
}
.empty-state {
  text-align: center;
  padding: 200rpx 30rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #86909C;
}
