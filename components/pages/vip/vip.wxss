/* pages/vip/vip.wxss */
.container {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* 顶部Banner - 企查查蓝渐变 */
.vip-banner {
  position: relative;
  padding: 60rpx 30rpx 80rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #1677FF 0%, #0052D9 100%);
}
.vip-banner::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,215,0,0.15) 0%, transparent 70%);
  border-radius: 50%;
}
.banner-content {
  position: relative;
  z-index: 1;
}
.banner-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}
.banner-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}
.banner-status {
  margin-top: 20rpx;
}
.status-text {
  font-size: 24rpx;
  color: #FFD700;
  background: rgba(255,215,0,0.15);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 通用section */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 24rpx;
  padding: 0 30rpx;
}

/* 会员权益 */
.benefits-section {
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
  padding: 0 30rpx;
}
.benefits-grid {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.benefit-item {
  width: calc(50% - 10rpx);
  text-align: center;
  padding: 20rpx 0;
}
.benefit-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}
.benefit-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 4rpx;
}
.benefit-desc {
  font-size: 22rpx;
  color: #86909C;
}

/* 套餐选择 */
.plans-section {
  margin-top: 40rpx;
}
.plans-list {
  padding: 0 30rpx;
  display: flex;
  gap: 16rpx;
}
.plans-list-single {
  display: block;
  padding: 0 30rpx;
}
.plan-item {
  flex: 1;
  background: #fff;
  border: 2rpx solid #E5E6EB;
  border-radius: 16rpx;
  padding: 30rpx 16rpx;
  text-align: center;
  position: relative;
}
.plan-item-year {
  border: 2rpx solid #FFD700;
  background: linear-gradient(180deg, #fffbe6 0%, #fff 100%);
  box-shadow: 0 8rpx 24rpx rgba(255,165,0,0.2);
  padding: 40rpx 30rpx;
}
.plan-item.selected {
  border-color: #1677FF;
  background: #f0f7ff;
  box-shadow: 0 4rpx 16rpx rgba(22,119,255,0.15);
}
.plan-badge {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}
.plan-name {
  font-size: 32rpx;
  color: #1D2129;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.plan-price {
  margin-bottom: 8rpx;
}
.price-symbol {
  font-size: 28rpx;
  color: #c62828;
  font-weight: 600;
}
.price-num {
  font-size: 64rpx;
  color: #c62828;
  font-weight: bold;
}
.plan-original {
  font-size: 24rpx;
  color: #C9CDD4;
  text-decoration: line-through;
  margin-bottom: 8rpx;
}
.plan-unit {
  font-size: 24rpx;
  color: #86909C;
  margin-bottom: 12rpx;
}
.plan-gift {
  display: inline-block;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  color: #ef6c00;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
  margin-top: 8rpx;
}

/* 单次查询提示 */
.single-tip {
  text-align: center;
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #4E5969;
}
.single-link {
  color: #1677FF;
  margin-left: 8rpx;
}

/* FAQ */
.faq-section {
  margin-top: 40rpx;
  padding: 0 30rpx;
}
.faq-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
}
.faq-item {
  border-bottom: 1rpx solid #F2F3F5;
}
.faq-item:last-child { border-bottom: none; }
.faq-q {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #1D2129;
  font-weight: 500;
}
.faq-arrow {
  color: #C9CDD4;
  font-size: 28rpx;
  transition: transform 0.2s;
}
.faq-arrow.open {
  transform: rotate(90deg);
}
.faq-a {
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.6;
  padding-bottom: 24rpx;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.agreement {
  font-size: 22rpx;
  color: #86909C;
  text-align: center;
  margin-top: 12rpx;
}
